# Server Configuration
SERVER_IP=0.0.0.0
SERVER_PORT=8080

# Database Configuration
# Note: DB_USER and DB_NAME are used in code (not DB_USERNAME/DB_DATABASE)
DB_HOST=mariadb
DB_PORT=3306
DB_USER=forex_user
DB_PASSWORD=forex_password
DB_NAME=db_forex
DB_ROOT_PASSWORD=root_password          # For MariaDB root user (Docker setup)
DB_MAX_RETRIES=5                       # Connection retry attempts
DB_RETRY_DELAY=2.0                     # Initial retry delay in seconds
DB_VERBOSE=false                       # Enable verbose database logging
DB_POOL_NAME=server_pool               # Connection pool name

# Database Backup Configuration
DB_BACKUP_DIR=/backups
DB_BACKUP_RETENTION_DAYS=7

# Web Scrapers
URL_MYFXBOOK=https://www.myfxbook.com/
MYFXBOOK_EMAIL=YOUR_EMAIL
MYFXBOOK_PASSWORD=YOUR_PASSWORD
URL_FOREXLIVE=https://www.forexlive.com/  # Currently not used in codebase

# AI Configuration - General
AI_AUTO_START=true
AI_TRADING_ENABLED=false                # Enable live trading (use with caution!)
AI_LIVE_TRAINING_ENABLED=true
AI_TRAINING_ENABLED=true

# AI Configuration - Training
AI_DECISION_INTERVAL=60                 # Decision interval in seconds
AI_EPISODE_DURATION_HOURS=24            # Episode duration in hours
AI_MIN_EXPERIENCES=1000                 # Minimum experiences before training
AI_SAVE_FREQ_STEPS=1000                 # Save model every N steps
AI_ARCHITECTURE_CONFIG=                 # Optional path to architecture config JSON

# AI Configuration - Agent (DQN)
AI_LEARNING_RATE=0.001
AI_DISCOUNT_FACTOR=0.95
AI_EPSILON=1.0                          # Initial exploration rate
AI_EPSILON_MIN=0.01                     # Minimum exploration rate
AI_EPSILON_DECAY=0.995                  # Exploration decay rate
AI_MEMORY_SIZE=10000                    # Replay buffer size
AI_BATCH_SIZE=32                        # Training batch size
AI_TARGET_UPDATE_FREQ=100               # Target network update frequency
AI_USE_DOUBLE_DQN=true                  # Use Double DQN algorithm

# AI Configuration - Environment
ENV_WINDOW_SIZE=50                      # Observation window size
ENV_FEATURES_PER_PAIR=20                # Features per currency pair
ENV_NORMALIZATION_METHOD=robust         # Normalization method (robust/standard/minmax)

# Risk Management Configuration
RISK_MAX_POSITION_SIZE=0.1              # Max position size (10% of account)
RISK_MAX_DAILY_LOSS=0.05                # Max daily loss (5% of account)
RISK_MAX_DRAWDOWN=0.20                  # Max drawdown (20% of account)
RISK_STOP_LOSS_PCT=0.02                 # Stop loss percentage (2%)
RISK_TAKE_PROFIT_PCT=0.04               # Take profit percentage (4%)
RISK_MAX_OPEN_POSITIONS=3               # Maximum open positions
RISK_CONFIG_FROM_ENV=false              # Load risk config from env vars

# Trading Configuration - General
WINDOW_SIZE=50                          # Observation window size
DECISION_INTERVAL=60                    # Decision interval in seconds
FEATURES_PER_PAIR=20                    # Features per currency pair
MAX_POSITION_SIZE=0.1                   # Max position size
MAX_DAILY_LOSS=0.05                    # Max daily loss
MAX_DRAWDOWN=0.20                       # Max drawdown
STOP_LOSS_PCT=0.02                      # Stop loss percentage
TAKE_PROFIT_PCT=0.04                    # Take profit percentage
MAX_OPEN_POSITIONS=3                    # Max open positions
MAX_CORRELATED_POSITIONS=2              # Max correlated positions

# Trading Configuration - Data Quality
MAX_DATA_STALENESS=60                   # Max data staleness in seconds
MAX_DATA_STALENESS_WARNING=300          # Warning threshold in seconds

# Trading Configuration - Tick Streaming
TICK_BATCH_SIZE=50                      # Batch size for tick processing
TICK_BATCH_INTERVAL=2.0                 # Batch interval in seconds
TICK_BUFFER_MAX_SIZE=200                # Max buffer size for ticks
DB_WRITE_QUEUE_SIZE=1000                # Database write queue size

# Trading Configuration - DQN Agent (Legacy - use AI_* prefixed vars)
LEARNING_RATE=0.001
DISCOUNT_FACTOR=0.95
EPSILON=1.0
EPSILON_MIN=0.01
EPSILON_DECAY=0.995
MEMORY_SIZE=10000
BATCH_SIZE=32
TARGET_UPDATE_FREQ=100
USE_DOUBLE_DQN=true
USE_PER=true                            # Use Prioritized Experience Replay
PER_ALPHA=0.6                           # PER alpha parameter
PER_BETA=0.4                            # PER beta parameter
PER_BETA_INCREMENT=0.001                 # PER beta increment

# Trading Configuration - Feature Engineering
DRIFT_THRESHOLD=0.25                    # Feature drift detection threshold
DRIFT_N_BINS=10                         # Number of bins for drift detection

# Trading Configuration - Economic Calendar
ECONOMIC_CALENDAR_HOURS_AHEAD=24        # Hours ahead to fetch events

# Trading Configuration - Technical Indicators
SMA_PERIOD_20=20                        # Simple Moving Average period
SMA_PERIOD_50=50                        # SMA period
EMA_PERIOD_12=12                        # Exponential Moving Average period
EMA_PERIOD_26=26                        # EMA period
RSI_PERIOD=14                           # Relative Strength Index period
MACD_FAST=12                            # MACD fast period
MACD_SLOW=26                            # MACD slow period
MACD_SIGNAL=9                           # MACD signal period
BOLLINGER_PERIOD=20                     # Bollinger Bands period
BOLLINGER_STD=2.0                       # Bollinger Bands standard deviation

# Logging Configuration
LOG_DIR=./logs                           # Log directory path
USE_STRUCTURED_LOGGING=false            # Enable structured JSON logging
LOG_FORMAT=json                          # Log format: json or readable
AI_MODEL_LOG_LEVEL=INFO                 # AI model logger level (DEBUG/INFO/WARNING/ERROR)
# Component-specific log levels (optional):
# TICK_STREAMER_LOG_LEVEL=INFO
# SERVER_LOG_LEVEL=INFO

# TensorFlow Configuration
TF_XLA_COMPILATION=false                # Enable XLA compilation for TensorFlow
