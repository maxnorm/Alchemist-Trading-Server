# ============================================
# Logs Configuration
# ============================================
LOG_DIR=./logs                                  # Log directory path
USE_STRUCTURED_LOGGING=true                     # Enable structured JSON logging
LOG_FORMAT=json                                 # Log format: json or readable
AI_MODEL_LOG_LEVEL=DEBUG                        # AI model logger level (DEBUG/INFO/WARNING/ERROR)
KILL_SWITCH_FILE=/app/logs/kill_switch.flag     # Kill switch file path (default: /app/logs/kill_switch.flag)

# ============================================
# MT5 EA - Tick Stream Auth Token
# ============================================
STREAMER_AUTH_TOKEN=<- YOUR  AUTH TOKEN FOR MT5 STREAMER ->

# ============================================
# CLERK CONFIGURATION
# ============================================
CLERK_SECRET_KEY=<-YOUR CLERK SECRET->
CLERK_PUBLISHABLE_KEY=<-YOUR CLERK PUB KEY->
# Seed for dev account
# CLERK_SEED_ENABLED=true
# CLERK_SEED_EMAIL=dev@localhost.dev
# CLERK_SEED_PASSWORD=2l6d7i5M25


# ============================================
# DATABASE CONFIGURATION (Override defaults for production)
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=db_forex
DB_USER=<- YOUR DB USER ->
DB_PASSWORD=<- YOUR DB PASSWORD ->

# ============================================
# DATABASE POOL CONFIGURATION (Performance Tuning)
# ============================================
DB_POOL_SIZE=10                                 # Connection pool size (default: 10)
DB_MAX_OVERFLOW=20                              # Max overflow connections (default: 20)
DB_POOL_PRE_PING=true                           # Enable connection health checks (default: true)
DB_POOL_RECYCLE=3600                            # Connection recycle time in seconds (default: 3600)
DB_MAX_RETRIES=5                                # Max database retry attempts (default: 5)
DB_RETRY_DELAY=2.0                              # Retry delay in seconds (default: 2.0)
DB_VERBOSE=false                                # Enable verbose database logging (default: false)

# ============================================
# TRADING SERVER CONFIGURATION
# ============================================
SERVER_IP=0.0.0.0
SERVER_PORT=8080

# ============================================
# MT5 CONFIGURATION
# ============================================
MT5_SERVER_PUBLIC_HOST=127.0.0.1
MT5_SERVER_PUBLIC_PORT=8080                     # Must match gateway port 8080
MT5_SOCKET_TIMEOUT=30.0                         # Socket timeout in seconds (default: 30.0)

# ============================================
# API CONFIGURATION
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1
API_BASE_PATH=/api
LOG_LEVEL=INFO

# ============================================
# DASHBOARD CONFIGURATION
# ============================================
VITE_API_URL=                                   # Leave empty to use gateway routing
VITE_WS_URL=/ws

# ============================================
# GATEWAY CONFIG
# ============================================
VITE_API_URL=                                   # Leave empty to use gateway routing
VITE_WS_URL=/ws

# ============================================
# MLFLOW CONFIGUTATION
# ============================================
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_URI=http://mlflow:5000

# ============================================
# PROMETHEUS CONFIGURATION
# ============================================
PROMETHEUS_PORT=9090

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<- YOUR GRAFANA ADMIN PASSWORD ->


# ============================================
# MyFxBook
# ============================================
URL_MYFXBOOK=https://www.myfxbook.com/
MYFXBOOK_EMAIL=<- YOUR MYFXBOOK ACCOUNT EMAIL ->
MYFXBOOK_PASSWORD=<- YOUR MYFXBOOK ACCOUNT PASSWORD ->

# ============================================
# Forexlive
# ============================================
URL_FOREXLIVE=https://www.forexlive.com/

# ============================================
# AI/ML API KEYS (Optional - for LLM-based web scraping)
# ============================================
OPENAI_API_KEY=<- YOUR OPENAI API KEY ->
ANTHROPIC_API_KEY=<- YOUR ANTHROPIC API KEY ->

# ============================================
# OPTIONAL SECRETS (Recommended for Production)
# ============================================
AIRFLOW_FERNET_KEY=your_fernet_key_here         # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FRED_API_KEY=your_fred_api_key
NEWSAPI_API_KEY=your_newsapi_key

# ============================================
# QUALITY GATE CONFIGURATION (Optional)
# ============================================
QUALITY_GATE_CAPTURE_ALL_MODE=true             # Capture all data mode (default: true)
QUALITY_GATE_STALENESS_THRESHOLD_SECONDS=3600  # Staleness threshold in seconds (default: 3600 in capture-all mode, 300 otherwise)
QUALITY_GATE_DUPLICATE_TOLERANCE_SECONDS=0.001 # Duplicate tolerance in seconds (default: 0.001)

# ============================================
# TRADING ENVIRONMENT CONFIGURATION (Optional)
# ============================================
ENV_WINDOW_SIZE=100                             # Window size for feature engineering (uses TradingConstants.DEFAULT_WINDOW_SIZE if not set)
ENV_FEATURES_PER_PAIR=50                       # Features per trading pair (uses TradingConstants.DEFAULT_FEATURES_PER_PAIR if not set)
ENV_NORMALIZATION_METHOD=robust                 # Normalization method (default: robust)

# ============================================
# CELERY CONFIGURATION (Optional - has defaults)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0         # Celery broker URL (default: redis://redis:6379/0)
CELERY_RESULT_BACKEND=redis://redis:6379/0     # Celery result backend (default: redis://redis:6379/0)

# ============================================
# BACKUP CONFIGURATION (Optional)
# ============================================
DB_BACKUP_DIR=/backups                         # Backup directory (default: /backups)
DB_BACKUP_RETENTION_DAYS=7                     # Backup retention days (default: 7)
